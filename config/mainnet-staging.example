# Planning template only. NOT a deployable Mainnet release or verified inventory.
# Never set VITE_ALLOW_MAINNET=true to bypass unimplemented financial routes.
VITE_SOLANA_CLUSTER=mainnet-beta
SOLANA_CLUSTER=mainnet-beta
VITE_EXPLORE_CLUSTER=mainnet-beta
VITE_MAINNET_READ_ONLY=true
MAINNET_APP_ORIGIN=https://REPLACE_WITH_MAINNET_STAGING_HOST
VITE_ALLOW_MAINNET=false
VITE_DEV_MODE=false
VITE_DEV_AUTOCONNECT=false
DEV_WALLET_ENABLED=false
VITE_FUNDED_TRADE_FEE_BPS=100
# Creator buy cap is enforced in application/transaction policy at 20%.
# Do not put Helius keys in VITE_* variables or a committed config.
# Resolve SOLANA_RPC_URL securely at preflight runtime; example only:
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_IN_SECRET_STORE
DEVNET_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_IN_SECRET_STORE
DATABASE_URL=REPLACE_WITH_ISOLATED_MAINNET_POSTGRES
DEVNET_DATABASE_URL=REPLACE_WITH_DEVNET_DATABASE_FOR_ISOLATION_CHECK
FUNDED_STORE_PATH=
# Exact independently reviewed deployments; no Devnet IDs copied as defaults.
FUNDED_FEE_ROUTER_PROGRAM_ID=REPLACE_REWARD_ROUTER_ID
VITE_FUNDED_FEE_ROUTER_PROGRAM_ID=REPLACE_REWARD_ROUTER_ID
FUNDED_REWARD_PROGRAM_DATA_SHA256=REPLACE_64_CHARACTER_HASH
FUNDED_V3_FEE_ROUTER_PROGRAM_ID=REPLACE_V3_ROUTER_ID
FUNDED_V3_PROGRAM_DATA_SHA256=REPLACE_64_CHARACTER_HASH
FUNDED_DEVELOPER_LOCK_PROGRAM_ID=REPLACE_ESCROW_ID
FUNDED_DEVELOPER_LOCK_PROGRAM_DATA_SHA256=REPLACE_64_CHARACTER_HASH
# This preflight expects the same reviewed upgrade authority for all three roles.
# Alternatively leave authority empty and require ALL programs to be immutable.
MAINNET_APPROVED_UPGRADE_AUTHORITY=REPLACE_REVIEWED_AUTHORITY
MAINNET_APPROVED_IMMUTABLE_PROGRAM=false
FUNDED_TOKEN_MINT=REPLACE_MAINNET_FUNDED_MINT
VITE_FUNDED_TOKEN_MINT=REPLACE_MAINNET_FUNDED_MINT
FUNDED_TRADE_FEE_OWNER=REPLACE_MAINNET_PLATFORM_FEE_RECIPIENT
VITE_FUNDED_TRADE_FEE_OWNER=REPLACE_MAINNET_PLATFORM_FEE_RECIPIENT
METADATA_STORAGE=pinata
PINATA_JWT_FILE=/run/secrets/mainnet_metadata_token
