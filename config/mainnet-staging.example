# Planning template only. NOT a deployable Mainnet release or verified inventory.
# Never set VITE_ALLOW_MAINNET=true to bypass unimplemented financial routes.
# Fill public values and secret-file references in a private copy, never credential values here.
# Empty budget/review fields are placeholders, not approval or a zero-cost deployment.
# Fresh isolated installation: new Mainnet database/cache/deployment/production signers.
# Do not import Devnet financial state, sessions, pending transactions or QA keys.
VITE_SOLANA_CLUSTER=mainnet-beta
SOLANA_CLUSTER=mainnet-beta
MAINNET_PROGRAM_LAYOUT=merged-v3
VITE_EXPLORE_CLUSTER=mainnet-beta
VITE_MAINNET_READ_ONLY=true
MAINNET_APP_ORIGIN=https://richpad.fun
VITE_ALLOW_MAINNET=false
VITE_DEV_MODE=false
VITE_DEV_AUTOCONNECT=false
DEV_WALLET_ENABLED=false
FUNDED_API_ONLY=true
# No financial workers or transaction signers run in read-only staging.
FUNDED_V3_LAUNCH_ENABLED=false
FUNDED_V3_COLLECTION_ENABLED=false
FUNDED_V3_SETTLEMENT_ENABLED=false
FUNDED_V3_AUTO_SETTLEMENT_ENABLED=false
FUNDED_V3_AUTO_DISBURSEMENT_ENABLED=false
FUNDED_V3_HOLDER_WORKER_ENABLED=false
FUNDED_V3_BUYBACK_ENABLED=false
FUNDED_V3_AGENCY_BUYBACK_ENABLED=false
FUNDED_V3_X_CLAIMS_ENABLED=false
X_POST_ENABLED=false
VITE_FUNDED_TRADE_FEE_BPS=100
# Creator buy cap is enforced in application/transaction policy at 20%.
# Do not put Helius keys in VITE_* variables or a committed config.
# Use: node scripts/mainnet-readiness-preflight.mjs --config PATH [--online]
# The explicit loader resolves these references without inheriting .env.local.
# Relative file references are resolved against the configuration file directory.
SOLANA_RPC_URL_FILE=REPLACE_WITH_MAINNET_RPC_SECRET_FILE_PATH
DEVNET_SOLANA_RPC_URL_FILE=REPLACE_WITH_DEVNET_RPC_SECRET_FILE_PATH
DATABASE_URL_FILE=REPLACE_WITH_MAINNET_DATABASE_SECRET_FILE_PATH
DEVNET_DATABASE_URL_FILE=REPLACE_WITH_DEVNET_DATABASE_SECRET_FILE_PATH
# Optional server-only market fallback; no Devnet token data comes from Birdeye.
BIRDEYE_API_KEY_FILE=
BIRDEYE_API_URL=https://public-api.birdeye.so
BIRDEYE_CHAIN=solana
FUNDED_STORE_PATH=
# One independently reviewed merged production deployment; no Devnet defaults.
# Legacy config names are aliases, not instructions to deploy a second router.
FUNDED_FEE_ROUTER_PROGRAM_ID=REPLACE_MERGED_ROUTER_ID
VITE_FUNDED_FEE_ROUTER_PROGRAM_ID=REPLACE_MERGED_ROUTER_ID
FUNDED_REWARD_PROGRAM_DATA_SHA256=REPLACE_MERGED_PROGRAMDATA_HASH
FUNDED_V3_FEE_ROUTER_PROGRAM_ID=REPLACE_MERGED_ROUTER_ID
FUNDED_V3_PROGRAM_DATA_SHA256=REPLACE_MERGED_PROGRAMDATA_HASH
FUNDED_DEVELOPER_LOCK_PROGRAM_ID=REPLACE_MERGED_ROUTER_ID
FUNDED_DEVELOPER_LOCK_PROGRAM_DATA_SHA256=REPLACE_MERGED_PROGRAMDATA_HASH
FUNDED_V3_COMMUNITY_ACCOUNT_SETUP=app
# Both roles must resolve to the same program, full ProgramData hash and authority.
# Keep the program upgradeable. A reviewed, non-empty authority is mandatory.
MAINNET_APPROVED_UPGRADE_AUTHORITY=REPLACE_REVIEWED_AUTHORITY
MAINNET_APPROVED_IMMUTABLE_PROGRAM=false
# RICH will launch on pump.fun. Record its actual Mainnet mint after launch.
# The current pricing/buyback implementation requires its canonical SOL/RICH
# PumpSwap pool after graduation. A derived pool address alone is not liquidity.
# Keep legacy FUNDED_* variable names for application compatibility.
FUNDED_TOKEN_MINT=REPLACE_MAINNET_FUNDED_MINT
VITE_FUNDED_TOKEN_MINT=REPLACE_MAINNET_FUNDED_MINT
FUNDED_SWAP_POOL=REPLACE_MAINNET_FUNDED_POOL
VITE_FUNDED_SWAP_POOL=REPLACE_MAINNET_FUNDED_POOL
# These must match the final bytecode build inputs and reviewed public manifest.
FUNDED_TRADE_FEE_OWNER=REPLACE_MAINNET_PLATFORM_FEE_RECIPIENT
VITE_FUNDED_TRADE_FEE_OWNER=REPLACE_MAINNET_PLATFORM_FEE_RECIPIENT
METADATA_STORAGE=pinata
PINATA_JWT_FILE=REPLACE_WITH_MAINNET_METADATA_SECRET_FILE_PATH

# Release planning fields; these do not activate signers, workers or deployment.
# Copy the completed values into mainnet-deployment-plan.json and mainnet-acceptance-plan.json.
MAINNET_DEPLOYMENT_PAYER_SIGNER_REFERENCE=REPLACE_WITH_SIGNER_REFERENCE_NOT_PRIVATE_KEY
MAINNET_MAXIMUM_TOTAL_SPEND_LAMPORTS=
MAINNET_MAXIMUM_PRIORITY_FEE_LAMPORTS=
MAINNET_INDEPENDENT_REVIEWER=REPLACE_WITH_REVIEWER_NAME
MAINNET_INDEPENDENT_REVIEW_REFERENCE=REPLACE_WITH_FINAL_BINARY_REVIEW_REPORT_REFERENCE

# Public treasury and admin roles; Mainnet must never reuse local QA signer files.
FUNDED_V3_OPERATIONS_RECIPIENT=REPLACE_WITH_MAINNET_OPERATIONS_WALLET
FUNDED_PUMP_REVENUE_WALLET=REPLACE_WITH_MAINNET_REVENUE_WALLET
FUNDED_BOOST_PAYMENT_WALLET=REPLACE_WITH_MAINNET_BOOST_WALLET
FUNDED_SERVICE_FEE_RECIPIENT=REPLACE_WITH_MAINNET_SERVICE_FEE_WALLET
FUNDED_ADMIN_WALLETS=REPLACE_WITH_MAINNET_ADMIN_PUBLIC_WALLET
FUNDED_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
FUNDED_ADMIN_EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
FUNDED_ADMIN_EMAIL_PROVIDER=gmail
FUNDED_ADMIN_GMAIL_APP_PASSWORD_FILE=REPLACE_WITH_MAINNET_EMAIL_SECRET_FILE
# Read-only staging has no withdrawal signers. Configure separately after review.
FUNDED_ADMIN_OPERATIONS_SIGNER_FILE=
FUNDED_ADMIN_PUMP_REVENUE_SIGNER_FILE=
FUNDED_ADMIN_TRADE_FEE_SIGNER_FILE=
FUNDED_ADMIN_SERVICE_FEE_SIGNER_FILE=
FUNDED_ADMIN_BOOST_SIGNER_FILE=
