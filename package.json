{
  "name": "richpad-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mainnet:packet": "node scripts/mainnet-launch-packet.mjs",
    "mainnet:staging": "node scripts/start-mainnet-staging.mjs",
    "build:mainnet-preview": "node scripts/mainnet-preview.mjs build",
    "start:mainnet-preview": "node scripts/mainnet-preview.mjs serve",
    "release:devnet": "node scripts/funded-release.mjs",
    "verify:css-budget": "node scripts/verify-css-budget.mjs",
    "receipts:retention": "node scripts/receipt-retention.mjs",
    "receipts:status": "node scripts/receipt-worker-status.mjs",
    "receipts:backfill": "node scripts/backfill-receipts.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.x server/index.mjs",
    "rewards:status": "node scripts/reward-scheduler-status.mjs",
    "rewards:deploy-devnet": "node --env-file=.env.local scripts/deploy-reward-program-devnet.mjs",
    "community:vaults:devnet": "node --env-file=.env.local scripts/initialize-community-vaults-devnet.mjs",
    "qa:fund-burn-wallets": "node --env-file=.env.local --env-file-if-exists=.env.devnet-app-roles.local scripts/provision-funded-qa-budget.mjs",
    "mint:funded-devnet": "node --env-file=.env.local scripts/mint-funded-devnet.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "deploy:init": "node scripts/init-local-deploy.mjs",
    "check": "node scripts/check-source.mjs && npm run check:structure",
    "release:manifest": "node scripts/release-manifest.mjs",
    "x:posts": "node scripts/run-x-post-worker.mjs",
    "check:structure": "node scripts/check-source-size.mjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^2.0.0",
    "@pump-fun/pump-swap-sdk": "^1.20.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "lightweight-charts": "5.2.1",
    "nodemailer": "10.4.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^1.4.4",
    "redis": "6.3.1",
    "tweetnacl": "^1.0.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "overrides": {
    "bigint-buffer": "file:vendor/bigint-buffer",
    "jayson": "^5.0.0",
    "toml": "^5.0.1",
    "uuid": "^14.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
